# Copy to /opt/dcms/.env on the server (chmod 600). Never commit real values.
POSTGRES_DB=dcms
POSTGRES_USER=dcms
POSTGRES_PASSWORD=
# At least 32 bytes, e.g. `openssl rand -base64 48`.
JWT_SIGNING_KEY=
# URL users open in the browser; also the PayOS return URL.
PUBLIC_WEB_URL=http://192.168.10.251
WEB_PORT=80
# Only needed for the demo seed job.
DEV_SEED_PASSWORD=
GOOGLE_WEB_CLIENT_ID=
SMTP_HOST=
SMTP_PORT=465
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=DCMS - Phòng khám nha khoa
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Virus scanning of uploads: Disabled (default, saves ~1.5-2.5 GB RAM) or ClamAv (also add "antivirus" to COMPOSE_PROFILES).
CLINICAL_ANTIVIRUS=Disabled
# Public access: set the tunnel token, then COMPOSE_PROFILES=public (comma-separate profiles, e.g. public,antivirus).
CLOUDFLARE_TUNNEL_TOKEN=
COMPOSE_PROFILES=
