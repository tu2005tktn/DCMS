# Copy to /opt/dcms/.env on the server (chmod 600). Never commit real values.
POSTGRES_DB=dcms
POSTGRES_USER=dcms
POSTGRES_PASSWORD=
# At least 32 bytes, e.g. `openssl rand -base64 48`.
JWT_SIGNING_KEY=
# URL users open in the browser; also the PayOS return URL.
PUBLIC_WEB_URL=http://192.168.10.251
WEB_PORT=80
# Only needed for the demo seed job.
DEV_SEED_PASSWORD=
GOOGLE_WEB_CLIENT_ID=
SMTP_HOST=
SMTP_PORT=465
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=DCMS - Phòng khám nha khoa
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Public access: set the tunnel token, then COMPOSE_PROFILES=public (comma-separate profiles, e.g. public,ai).
CLOUDFLARE_TUNNEL_TOKEN=
COMPOSE_PROFILES=
# AI X-ray (CPU) on this server: copy the weights to AI_MODELS_DIR, add "ai" to COMPOSE_PROFILES,
# set DENTAL_AI_BASE_URL=http://ai:8090 and a random DENTAL_AI_API_KEY (openssl rand -hex 32). Empty URL disables AI.
DENTAL_AI_BASE_URL=
DENTAL_AI_API_KEY=
DENTAL_AI_TIMEOUT_SECONDS=120
AI_MODELS_DIR=/opt/dcms/ai-models
AI_CARIES_WEIGHTS_FILE=recommended_caries_best.pt
AI_MEMORY_LIMIT=1500m
AI_CPU_THREADS=2
