<?xml version="1.0" encoding="utf-8"?>
<!-- Code coverage for the DCMS backend (docs/testing/INTEGRATION-TEST-COVERAGE.vi.md).
     Measures the four src assemblies; generated EF Core migrations and the model snapshot are excluded. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[DCMS.Api]*,[DCMS.Application]*,[DCMS.Domain]*,[DCMS.Infrastructure]*</Include>
          <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <SkipAutoProps>true</SkipAutoProps>
          <DeterministicReport>false</DeterministicReport>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
