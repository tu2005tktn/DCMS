{
  "Logging": {
    "LogLevel": {
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "DCMS",
    "Audience": "DCMS.Web",
    "SessionMinutes": 30
  },
  "Identity": {
    "Password": {
      "RequiredLength": 12,
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireNonAlphanumeric": true
    }
  },
  "Recovery": {
    "TokenLifetimeMinutes": 30,
    "ResendCooldownMinutes": 2,
    "MaxResends": 3,
    "MaxVerifyAttempts": 5,
    "RateLimitPerAccountPerHour": 5,
    "RateLimitPerIpPerHour": 20,
    "Channel": "Email",
    "CodeLength": 6,
    "VerificationBaseUrl": ""
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173", "http://127.0.0.1:5173"]
  }
}
