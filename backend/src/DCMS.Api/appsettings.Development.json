{
  "Logging": {
    "LogLevel": {
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "DCMS",
    "Audience": "DCMS.Web",
    "SessionMinutes": 30,
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Identity": {
    "Password": {
      "RequiredLength": 12,
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireNonAlphanumeric": true
    }
  },
  "Recovery": {
    "TokenLifetimeMinutes": 30,
    "ResendCooldownMinutes": 2,
    "MaxResends": 3,
    "MaxVerifyAttempts": 5,
    "RateLimitPerAccountPerHour": 50,
    "RateLimitPerIpPerHour": 500,
    "Channel": "Email",
    "CodeLength": 6,
    "VerificationBaseUrl": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:8081",
      "http://127.0.0.1:8081"
    ]
  }
}
