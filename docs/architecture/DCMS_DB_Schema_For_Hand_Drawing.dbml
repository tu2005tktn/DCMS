Ref: FAMILY_RECORD_ACCESS.PatientId > PATIENT_PROFILE.Id
Ref: FAMILY_RECORD_ACCESS.BranchId > SCHEDULING_BRANCH.Id
Ref: FAMILY_RECORD_ACCESS.DecidedBy > USER_ACCOUNT.Id
Ref: FAMILY_RECORD_ACCESS.OwnerAccountId > USER_ACCOUNT.Id
Ref: APPOINTMENT.FamilyMemberId > CUSTOMER_FAMILY_MEMBER.Id
Ref: APPOINTMENT.PatientId > PATIENT_PROFILE.Id
Ref: APPOINTMENT.BranchId > SCHEDULING_BRANCH.Id
Ref: APPOINTMENT.(ServiceId, BranchId) > SCHEDULING_SERVICE.(Id, BranchId)
Ref: APPOINTMENT.BookerAccountId > USER_ACCOUNT.Id
Ref: APPOINTMENT.DentistId > USER_ACCOUNT.EmployeeId
Ref: IN_APP_NOTIFICATION.AppointmentId > APPOINTMENT.Id
Ref: IN_APP_NOTIFICATION.NotificationId > IN_APP_NOTIFICATION.Id
Ref: IN_APP_NOTIFICATION.AccountId > USER_ACCOUNT.Id
Ref: VISIT.AppointmentId - APPOINTMENT.Id
Ref: VISIT.PatientId > PATIENT_PROFILE.Id
Ref: VISIT.BranchId > SCHEDULING_BRANCH.Id
Ref: VISIT.DentistId > USER_ACCOUNT.EmployeeId
