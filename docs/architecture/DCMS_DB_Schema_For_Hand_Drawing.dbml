Ref: USER_ACCOUNT.GroupId > ACCESS_GROUP.Id
Ref: LAB_WORK_TYPE.ProviderId > CATALOG_PROVIDER.Id
Ref: MATERIAL_CATALOG_ITEM.CategoryId > MATERIAL_CATEGORY.Id
