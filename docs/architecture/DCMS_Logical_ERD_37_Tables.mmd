    %% DCMS property-first logical ERD: 37 tables, 2026-10-06.
    %% 26 retained original tables + BILL_LINE replacing two original details + 10 additions.
    %% Read the implementation contract at the end; comments are not SQL enforcement.

    USER_ACCOUNT {
        Integer account_id PK
        String username UK
        String password_hash
        String email "Optional"
        String phone "Optional"
        String status
        DateTime contact_verified_at "Optional; account contact only"
        Boolean appointment_reminders_enabled
        Boolean follow_up_reminders_enabled
        Boolean medication_reminders_enabled
        Boolean push_enabled
        DateTime created_at
        DateTime updated_at
        Integer concurrency_version
    }

    ROLE {
        Integer role_id PK
        String role_code UK
        String role_name
        String description "Optional"
    }

    USER_ACCOUNT_ROLE {
        Integer account_id PK, FK
        Integer role_id PK, FK
    }

    EMPLOYEE_PROFILE {
        Integer employee_id PK
        Integer account_id FK, UK
        String employee_code UK
        String full_name
        Date birth_date "Optional"
        String phone "Optional"
        String professional_title "Optional"
        String license_number "Optional"
        String status
    }

    PATIENT_PROFILE {
        Integer patient_id PK
