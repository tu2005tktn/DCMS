sequenceDiagram
  autonumber
  actor D as Dentist
  participant UI as Treatment Screen
  participant S as TreatmentDossierService
  participant SA as SettingsAccess
  participant DB as Database
  D ->> UI : open the treatment plan of the dossier
  UI ->> S : getTreatmentPlan(dossier)
  activate S
  S ->> DB : load sample treatment plans of the branch
  S -->> UI : list of sample plans with their items and prices
  deactivate S
  D ->> UI : choose the sample plan that fits the diagnosis
  UI ->> S : applySamplePlan(dossier, samplePlan)
  activate S
  S ->> DB : copy the sample items into the plan (Draft)
  S -->> UI : plan with the listed items
  deactivate S
  loop until the plan fits the patient
  D ->> UI : add, edit or delete treatment items, adjust price and terms
  UI ->> S : saveDraft(dossier, plan)
  activate S
  S ->> S : dossier open, plan not committed, version unchanged
  S ->> S : validate goals, 1-100 items, payment terms
  S ->> DB : chosen services active in the branch?
  opt items added, removed or re-priced
  S ->> SA : require items create / delete / price permission
  end
  S ->> DB : save draft plan
  S -->> UI : plan draft saved
  deactivate S
  end
  D ->> UI : commit the plan
  UI ->> S : commitPlan(dossier)
  activate S
  S ->> S : plan is draft and has items
  S ->> S : counseling, decision maker, discounts, consents ready
  alt any rule fails
  S -->> UI : reject, plan stays draft
  else all rules pass
  S ->> DB : raise plan version, mark plan committed
  S ->> DB : save "plan committed" event and request record
  S -->> UI : committed plan and success message
  end
  deactivate S
