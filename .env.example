# Copy to .env and choose a private local password. Never commit .env.
POSTGRES_DB=dcms_dev
POSTGRES_USER=dcms
POSTGRES_PASSWORD=replace-with-a-private-local-password
POSTGRES_PORT=5432

# Generated locally by initialize-development.ps1; never commit real values.
JWT_SIGNING_KEY=
DEV_SEED_PASSWORD=

# Public Google OAuth Web Client ID for browser sign-in (no client secret needed).
GOOGLE_WEB_CLIENT_ID=

# SMTP for Public email confirmation and S03 recovery. Without it, confirmation reports a delivery error.
# Local test inbox: start Mailpit with "--profile mail", then SMTP_HOST=127.0.0.1, SMTP_PORT=1025, SMTP_ENABLE_SSL=false.
# Gmail: SMTP_HOST=smtp.gmail.com. Port 465 uses implicit SSL; port 587 uses STARTTLS.
# SMTP_PASSWORD is a Google App Password (16 chars), never the account password.
SMTP_HOST=
SMTP_PORT=465
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=DCMS - Phòng khám nha khoa
