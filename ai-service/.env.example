# Copy to ai-service/.env (never commit). Weights stay outside Git; use absolute paths.
AI_CARIES_WEIGHTS=C:\Xray-AI\artifacts\detector_weights\recommended_caries_best.pt
# Optional second model (impacted third molar). Leave empty to keep caries only.
AI_IMPACTED_WEIGHTS=
# Shared secret with the DCMS API (DENTAL_AI_API_KEY). Empty disables the check (local dev only).
AI_SERVICE_API_KEY=
# cpu, cuda, cuda:0 ... Empty picks cuda when available.
AI_DEVICE=
AI_CARIES_MIN_CONFIDENCE=0.25
AI_CARIES_SINGLE_SOURCE_MIN_CONFIDENCE=0.35
AI_IMPACTED_MIN_CONFIDENCE=0.25
